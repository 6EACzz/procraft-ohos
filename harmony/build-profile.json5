{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // The lowest API the port can run on: it asks the runtime for the app's own files folder
        // through OH_AbilityRuntime_ApplicationContextGetFilesDir, which arrived in API 16. Declaring
        // 12 here would promise a build that cannot find its own files on the devices that gave it
        // 12, so the manifest says what is true.
        "compatibleSdkVersion": "5.0.4(16)",
        // What the port is written against. It stays at 24 while later releases exist: that is the
        // API the app was tested on, and a newer target says the app has taken on whatever that
        // release changed in how the system treats it — a promise nothing here has checked.
        "targetSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        { "name": "default", "applyToProducts": ["default"] }
      ]
    }
  ]
}
