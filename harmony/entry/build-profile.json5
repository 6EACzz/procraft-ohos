{
  "apiType": "stageMode",
  "buildOption": {
    "resOptions": {
      "copyCodeResource": { "enable": false }
    },
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "-DOHOS_STL=c++_shared",
      "cppFlags": "-std=c++17",
      "abiFilters": ["arm64-v8a"]
    }
  },
  "targets": [
    { "name": "default" }
  ]
}
