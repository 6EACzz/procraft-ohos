{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "tablet",
      "2in1",
      "default"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // No permission is asked for here, on purpose. Reading the clipboard (`pasteboard.getData`)
    // wants `ohos.permission.READ_PASTEBOARD`, and that is a restricted permission: an ordinary
    // app cannot declare it at all, only receive it through an ACL in the signing profile. Until a
    // profile grants it, Pasting from the system's clipboard stays unread ("nothing" is answered,
    // and the paste is refused rather than the app stopping). Writing to the clipboard needs no
    // permission and works.
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        // The app is a canvas: it asks for the whole display, and for a frame of its own only when
        // the system gives it one (a split or floating window). Declaring both is what makes those
        // gestures available to it at all — an app that names only `fullscreen` is not offered them.
        "supportWindowMode": [
          "fullscreen",
          "split",
          "floating"
        ],
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ]
  }
}
